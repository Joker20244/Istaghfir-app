#!/usr/bin/env python3
"""تعديل ملفات الأندرويد لتفعيل الإشعارات والـ desugaring."""

import re
import sys
import os


def edit_manifest(path):
    """إضافة أذونات الإشعارات للـ AndroidManifest."""
    with open(path, 'r', encoding='utf-8') as f:
        content = f.read()

    # إضافة الأذونات قبل <application>
    if 'RECEIVE_BOOT_COMPLETED' not in content:
        perms = (
            '<uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>\n'
            '    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>\n'
            '    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>\n'
            '    <uses-permission android:name="android.permission.VIBRATE"/>\n'
            '    <application'
        )
        content = content.replace('<application', perms, 1)

    # إضافة الـ receivers قبل </application>
    if 'ScheduledNotificationReceiver' not in content:
        receivers = (
            '<receiver android:exported="false" '
            'android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver" />\n'
            '        <receiver android:exported="false" '
            'android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver">\n'
            '            <intent-filter>\n'
            '                <action android:name="android.intent.action.BOOT_COMPLETED"/>\n'
            '                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>\n'
            '            </intent-filter>\n'
            '        </receiver>\n'
            '    </application>'
        )
        content = content.replace('</application>', receivers, 1)

    with open(path, 'w', encoding='utf-8') as f:
        f.write(content)
    print("✓ Manifest updated")


def edit_gradle(path):
    """تفعيل desugaring في build.gradle."""
    with open(path, 'r', encoding='utf-8') as f:
        content = f.read()

    # تفعيل coreLibraryDesugaringEnabled
    if 'coreLibraryDesugaringEnabled' not in content:
        content = content.replace(
            'compileOptions {',
            'compileOptions {\n        coreLibraryDesugaringEnabled true',
            1
        )

    # إضافة الـ dependency
    if 'desugar_jdk_libs' not in content:
        content = re.sub(
            r'dependencies\s*\{',
            'dependencies {\n    coreLibraryDesugaring \'com.android.tools:desugar_jdk_libs:2.0.4\'',
            content,
            count=1
        )

    with open(path, 'w', encoding='utf-8') as f:
        f.write(content)
    print("✓ build.gradle updated")
    print("--- content ---")
    print(content)


def main():
    if len(sys.argv) < 2:
        print("Usage: setup_android.py <project_dir>")
        sys.exit(1)

    project_dir = sys.argv[1]
    manifest = os.path.join(project_dir, 'android/app/src/main/AndroidManifest.xml')
    gradle = os.path.join(project_dir, 'android/app/build.gradle')

    if not os.path.exists(manifest):
        print(f"✗ Manifest not found at {manifest}")
        sys.exit(1)

    if not os.path.exists(gradle):
        # بعض مشاريع Flutter بتستخدم build.gradle.kts
        gradle = os.path.join(project_dir, 'android/app/build.gradle.kts')
        if not os.path.exists(gradle):
            print(f"✗ build.gradle not found")
            sys.exit(1)

    edit_manifest(manifest)
    edit_gradle(gradle)
    print("✅ Done!")


if __name__ == '__main__':
    main()
